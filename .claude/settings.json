{
  "permissions": {
    "allow": [
      "Bash(python .sdlc/bin/sdlc.py *)",
      "Bash(python3 .sdlc/bin/sdlc.py *)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git checkout -b *)",
      "Bash(git switch -c *)"
