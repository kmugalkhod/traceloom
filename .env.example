# Traceloom settings. Copy to .env; every value can also be set in the process environment.

# --- Core ---
# dev | test | production. Outside dev, TRACELOOM_SERVER_SECRET is required (startup fails without it).
TRACELOOM_ENV=dev
# lite = SQL-only store, in-process queue, local blob folder. full = ClickHouse + Redis + S3.
TRACELOOM_MODE=lite
# Metadata (and, in lite mode, trace) database. SQLite for dev, Postgres for real use.
DATABASE_URL=sqlite:///./data/traceloom.db
# Signs session cookies and hashes API key secrets. Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
TRACELOOM_SERVER_SECRET=
# Public URL, used in emailed links.
TRACELOOM_BASE_URL=http://localhost:8000
# Raw ingestion batches (lite mode).
TRACELOOM_BLOB_DIR=./data/blobs
# Force the Secure cookie flag on/off. Empty = on in production only.
TRACELOOM_COOKIE_SECURE=
TRACELOOM_SESSION_HOURS=336

# --- Accounts ---
# false = sign-up only for invited emails.
TRACELOOM_SIGNUP_ENABLED=true
TRACELOOM_RESET_TOKEN_MINUTES=60
TRACELOOM_INVITE_TTL_HOURS=168

# --- Ingestion ---
TRACELOOM_INGEST_MAX_EVENTS=1000
TRACELOOM_INGEST_MAX_BYTES=5000000
# Pending batches older than this are re-enqueued by the sweeper.
TRACELOOM_INGEST_SWEEP_SECONDS=60
TRACELOOM_TRACE_WINDOW_HOURS=24

# --- Rate limits: <count>/<second|minute|hour> ---
# Per IP + email.
TRACELOOM_RATE_AUTH=10/minute
# Per API key.
TRACELOOM_RATE_INGEST=600/minute

# --- Full mode: Redis ---
REDIS_URL=redis://localhost:6379/0

# --- Full mode: S3-compatible blob storage (MinIO locally) ---
S3_ENDPOINT_URL=
S3_BUCKET=traceloom
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=us-east-1

# --- Full mode: ClickHouse ---
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=8123
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DATABASE=traceloom

# --- Mail: with SMTP_HOST empty, messages are logged to the console ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=traceloom@localhost
SMTP_STARTTLS=true
